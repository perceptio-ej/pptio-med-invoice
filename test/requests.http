    "episodeId": "4556777",
    "invoiceNumber": "FV-2026-000123"
  },
  "result": {
    "salesOrderNumber": "0000012345",
    "sapInvoiceNumber": "9000056789",
    "cufe": "38b060a751ac96384cd9327eb1b1e36a21fdb71114be07434c0cc7bf63f6e1da2"
  }
}

### Consultar estado: reemplazar con trackingId retornado
POST {{host}}/api/v1/invoiceExt/messageStatus
Authorization: Basic {{user}}:{{password}}
Content-Type: application/json

{
  "trackingId": "00000000-0000-0000-0000-000000000000"
}
